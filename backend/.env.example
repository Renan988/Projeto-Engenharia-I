# Configurações Gerais do Django
SECRET_KEY=django-insecure-intech-sistemas-sped-workflow-dev-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# SUPABASE - BANCO DE DADOS POSTGRESQL E AUTENTICAÇÃO (Substitui banco local)
# ==============================================================================
# 1. No painel do Supabase, acesse: Connect (ou Project Settings -> Database)
#    Copie a URI do "Session pooler" (porta 5432) ou "Transaction pooler" (porta 6543)
#    e substitua [YOUR-PASSWORD] pela senha do banco criada no Supabase:
DATABASE_URL=postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA_DO_BANCO]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# 2. No painel do Supabase, acesse: Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-public-key-do-supabase
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-do-supabase
SUPABASE_JWT_SECRET=seu-jwt-secret-do-supabase

# CORS - Origens permitidas para o Front-end React
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Configurações de E-mail (RF04.01 / RNF007)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@intechsistemas.com.br
EMAIL_MAX_RETRIES=3

# Configurações de API Externa - Consulta CNPJ (RF02.01)
CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1
CNPJ_API_TIMEOUT=5

# Configurações de API do WhatsApp (RF04.02 / RNF006)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_MAX_RETRIES=3
